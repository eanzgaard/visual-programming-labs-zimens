  {
    "id": "function08item",
    "type": "function",
    "z": "tab08zimens",
    "name": "200 / 400 / 404",
    "func": "const raw = msg.req.params.id;\nconst id = Number(raw);\nconst items = {\n    1: {id: 1, name: \"Keyboard\"},\n    2: {id: 2, name: \"Mouse\"},\n    3: {id: 3, name: \"Monitor\"}\n};\nmsg.headers = {\"Content-Type\": \"application/json; charset=utf-8\"};\nif (!Number.isInteger(id) || id <= 0) {\n    msg.statusCode = 400;\n    msg.payload = {error: \"invalid id\", student: \"Zimens\"};\n} else if (!items[id]) {\n    msg.statusCode = 404;\n    msg.payload = {error: \"item not found\", id: id};\n} else {\n    msg.statusCode = 200;\n    msg.payload = items[id];\n}\nreturn msg;",
